{
  "name": "thebolt-website",
  "version": "2.0.3",
  "private": true,
  "type": "module",
  "description": "Public website for THE BOLT — thebolt.stream, a ClubFM station.",
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "deploy:preview": "astro build && wrangler versions upload",
    "deploy:promote": "wrangler versions deploy",
    "check": "astro check && astro build",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply thebolt --local",
    "db:migrate": "wrangler d1 migrations apply thebolt --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@clubfm/player": "file:../clubfm-player",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
