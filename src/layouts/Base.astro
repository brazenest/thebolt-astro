---
/**
 * Base layout — the frame every page extends. Owns <head>, the pre-paint theme script,
 * self-hosted fonts, view transitions (ClientRouter), and the persistent player dock.
 *
 * ClientRouter is load-bearing: without view transitions, the dock's transition:persist is a
 * no-op and the stream dies on every link click.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-700.css';

import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/home.css';
import '../styles/log.css';
import '../styles/chart.css';
import '../styles/page.css';
import '../styles/contact.css';
import '../styles/dock-skins.css';

import { ClientRouter } from 'astro:transitions';
import PlayerDock from '@clubfm/player/PlayerDock.astro';
import { station } from '../config/station';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${station.name} — Vegas's Live Rock Radio | A ClubFM Station`,
  description = `Listen live to ${station.name}, Vegas's rock radio — modern rock, new classics, and classic rock, streaming around the clock at ${station.domain}. A ClubFM station.`,
} = Astro.props;

// Canonical always points at the production origin, whatever host served the request.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/brand/og.png', Astro.site);

// Sitewide station identity for search engines. Kept to durable facts — no schedule, no
// now-playing — so the markup never contradicts the live page.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'RadioStation',
  name: station.name,
  url: station.url,
  slogan: station.tagline,
  genre: station.genres,
  address: {
    '@type': 'PostalAddress',
    addressLocality: station.location.city,
    addressRegion: station.location.region,
    addressCountry: station.location.country,
  },
  logo: new URL('/brand/the-bolt-lockup.png', Astro.site).href,
  image: ogImage.href,
  parentOrganization: { '@type': 'Organization', name: 'ClubFM' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F4F4F4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={station.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${station.name} — ${station.tagline}`} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Blocking, pre-paint. Must run before first paint or the page flashes the wrong theme. -->
    <script is:inline>
      (function () {
        try {
          // Follow system preference until the listener explicitly chooses a theme. An explicit
          // choice persists for 7 days FOLLOWING THEIR MOST RECENT VISIT: the window slides
          // forward on every load, and lapses back to system after a week away.
          var KEY = 'bolt.theme',
            TKEY = 'bolt.theme.ts',
            WEEK = 6048e5; // 7 days in ms
          var t = localStorage.getItem(KEY);
          var ts = Number(localStorage.getItem(TKEY));
          var now = Date.now();
          if (t && ts && now - ts <= WEEK) {
            localStorage.setItem(TKEY, String(now)); // most recent visit → slide the window
          } else {
            if (t) {
              localStorage.removeItem(KEY); // stale (or malformed) choice → forget it
              localStorage.removeItem(TKEY);
            }
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <slot />

    <PlayerDock
      code={station.code}
      station={station.name}
      api={station.nowPlaying.api}
      pollMs={station.nowPlaying.pollMs}
      accent={station.accent}
      onAccent="#FFFFFF"
      stream={station.stream.primary}
      streamFallback={station.stream.fallback}
      idleTitle="Vegas rock radio"
      idleArtist={station.name}
    />

    <script>
      import '../scripts/ui.ts';
      import '../scripts/menu.ts';
    </script>
  </body>
</html>
