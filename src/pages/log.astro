---
/**
 * THE BOLT — /log. The full airing history, newest first, rendered from the `plays` log the
 * capture cron fills. On-demand (reads D1 per request).
 *
 * Client-side finishing (scripts/log.ts): play times re-render in the VISITOR'S local
 * timezone (the server can't know it; the SSR text is a UTC fallback for no-JS), the tick
 * marks fill with the listener's own ratings, and rows paginate — 10 visible initially,
 * "Show 5 more" per click, capped at 25 total. The deeper history stays unpublished for now
 * (a future ArtistTrack revision opens it up properly).
 */
import Base from '../layouts/Base.astro';
import SiteMast from '../components/SiteMast.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { getEnv } from '../lib/server/env';
import { recentPlays, type PlayRow } from '../lib/server/plays-db';
import { station } from '../config/station';

export const prerender = false;

const INITIAL_ROWS = 10;
// Public ceiling — the page never reveals more than this, by design (10 + 3 clicks of 5).
const MAX_ROWS = 25;

const env = getEnv(Astro.locals);
let plays: PlayRow[] = [];
try {
  if (env.DB) plays = await recentPlays(env.DB, MAX_ROWS);
} catch {
  plays = [];
}

// No-JS fallback only — the client rewrites every time into the visitor's local zone.
const fmtUtc = (unix: number): string =>
  new Date(unix * 1000).toLocaleString('en-US', {
    timeZone: 'UTC',
    month: 'short',
    day: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }) + ' UTC';
---

<Base
  title={`Recently Played — Full Song Log | ${station.name}`}
  description={`The full play log for ${station.name}, Vegas's rock station — every modern rock, new classic, and classic rock song aired, newest first, in your local timezone.`}
>
  <div class="site">
    <SiteMast />

    <section class="band" aria-labelledby="log-h">
      <h2 id="log-h">Full log</h2>
      <div>
        {
          plays.length ? (
            <table class="log" data-log>
              <caption class="sr">Every track played, newest first, with your ratings</caption>
              <colgroup>
                <col style="width:118px" />
                <col />
                <col style="width:80px" />
              </colgroup>
              <tbody>
                {plays.map((p, i) => (
                  <tr hidden={i >= INITIAL_ROWS}>
                    <td class="tm" data-ts={String(p.played_at)}>{fmtUtc(p.played_at)}</td>
                    <td class="nm">
                      <b>{p.title}</b> <s>— {p.artist}</s>
                      {p.album ? <span class="alb"> · {p.album}</span> : null}
                    </td>
                    <td class="tk" data-artist={p.artist} data-title={p.title} />
                  </tr>
                ))}
              </tbody>
            </table>
          ) : (
            <p class="log-empty">
              Nothing logged yet. Once the stream is live, every track lands here.
            </p>
          )
        }
        {
          plays.length > INITIAL_ROWS && (
            <button class="log-more" type="button" data-log-more>
              Show 5 more
            </button>
          )
        }
      </div>
    </section>

    <footer>
      <a href="/">← Back to live</a>
      <button class="ftl" type="button" data-contact-open>Contact</button>
      <span>{plays.length ? `Latest ${plays.length}` : '—'}</span>
    </footer>
  </div>

  <ContactDialog />

  <script>
    import '../scripts/log.ts';
    import '../scripts/contact.ts';
  </script>
</Base>
