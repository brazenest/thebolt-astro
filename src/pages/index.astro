---
/**
 * THE BOLT — home.
 *
 * The song areas ship as SUSPENSE — quiet skeleton washes, never placeholder tracks; a
 * production page must not assert songs it isn't playing. scripts/hero.ts subscribes to the
 * shared now-playing store (one poll for the whole page, owned by the dock) and resolves each
 * area on the first snapshot: the live track, the just-played list, or the honest empty
 * state. scripts/ui.ts owns theme + art-toggle. Static content (shows, request) still SSRs.
 */
import Base from '../layouts/Base.astro';
import SiteMast from '../components/SiteMast.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { station } from '../config/station';

const pad = (n: number) => String(n).padStart(2, '0');

const rank = ['Hate', 'Dislike', 'Neutral', 'Like', 'Love'];
const year = new Date().getFullYear();
---

<Base
  title={`${station.name} — Vegas's Live Rock Radio | A ClubFM Station`}
  description={`Listen live to ${station.name}, Vegas's rock station — modern rock, '90s–2015 new classics, and '60s–'70s classic rock, streaming around the clock at ${station.domain}.`}
>
  <div class="site">
    <SiteMast home />

    <!-- ON AIR -->
    <section class="band hero" id="air" aria-labelledby="air-h">
      <div class="gut">
        <h2 id="air-h">On air</h2>
        <figure class="plate" style="margin:0">
          {/* No src until the store delivers real art — the frame never shows a stand-in. */}
          <img alt="" data-np-art decoding="async" />
          <span class="tint" aria-hidden="true"></span>
          <span class="scr" aria-hidden="true"></span>
        </figure>
        <p class="sub">On air · <span data-np-clock></span></p>
      </div>
      <div>
        <div class="np-row">
          <div class="np-main">
            {/* Suspense: skeleton washes hold the geometry until the first snapshot. */}
            <h3 class="track" data-np-title><span class="skel skel--track"></span></h3>
            <p class="artist" data-np-artist><span class="skel skel--artist"></span></p>
            <p class="rel">
              <span data-np-release><span class="skel skel--rel"></span></span>
              <span data-np-duration></span>
            </p>
          </div>
          {/* On-page play control. The dock still owns the one <audio>; this dispatches
              clubfm:toggle and mirrors clubfm:playerstate — a consumer, not a second player. */}
          <button
            class="hero-play"
            type="button"
            data-hero-toggle
            aria-pressed="false"
            aria-label={`Play ${station.name}`}
          >
            <svg class="hp-play" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M8 5v14l11-7z" fill="currentColor"></path></svg
            >
            <svg class="hp-pause" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"></path></svg
            >
          </button>
        </div>
        <div class="el"><i data-np-elapsed style="width:0%"></i></div>

        <div class="rank" data-rank role="group" aria-label="SongRank this track">
          <span class="rank-h" aria-hidden="true">SongRank<sup>SM</sup></span>
          {/* The five ratings live in their own row so they can hold one line at every width —
              an even split of an odd count. On mobile the heading stacks above them. */}
          <div class="rank-opts">
            {
              rank.map((label, i) => (
                <button type="button" aria-pressed="false" value={String(i + 1)}>
                  {label}
                </button>
              ))
            }
          </div>
        </div>
        <p class="sr" role="status" aria-live="polite" id="rank-status"></p>
      </div>
    </section>

    <!-- REQUEST -->
    <section class="band req" id="request" aria-labelledby="req-h">
      <h2 id="req-h">Request</h2>
      <form method="post" action="/api/request" data-request-form>
        <label class="sr" for="req">Request a song</label>
        <input
          id="req"
          name="song"
          type="text"
          placeholder="Artist — title"
          required
          maxlength="120"
          autocomplete="off"
        />
        {/* Honeypot — hidden from people, tempting to bots. A filled value is dropped server-side. */}
        <input class="sr" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit">Send it</button>
        <p class="req-status sr" role="status" aria-live="polite" data-request-status></p>
      </form>
    </section>

    <!-- JUST PLAYED -->
    <section class="band" id="played" aria-labelledby="played-h">
      <h2 id="played-h">Just played</h2>
      <div>
        <table data-history>
          <caption class="sr">The last five songs, with ratings</caption>
          <colgroup>
            <col style="width:56px" /><col /><col style="width:80px" />
          </colgroup>
          <tbody>
            {/* Suspense rows — replaced by the real history (or an honest empty state) on the
                store's first snapshot. Never placeholder songs. */}
            {
              Array.from({ length: 5 }).map(() => (
                <tr>
                  <td class="tm">
                    <span class="skel skel--tm" />
                  </td>
                  <td class="nm">
                    <span class="skel skel--nm" />
                  </td>
                  <td class="tk" />
                </tr>
              ))
            }
          </tbody>
        </table>
        <a class="more" href="/log">Full log →</a>
      </div>
    </section>

    <!-- SHOWS — the schedule is PINNED TO PACIFIC: a show airs in one fixed real-world
         window for everyone. What varies is the label: the client rewrites each bracket into
         the visitor's local clock (10–15 PT reads as 11–16 in Denver) and highlights the show
         on air from the current Pacific hour, re-checking every minute (scripts/hero.ts).
         The SSR text below is the Pacific bracket — the no-JS fallback. -->
    <section class="band" id="shows" aria-labelledby="shows-h">
      <h2 id="shows-h">Shows</h2>
      <div class="shows" data-shows>
        {
          station.shows.map((s) => (
            <span data-start={String(s.start)} data-end={String(s.end)}>
              <span class="sh-t">{pad(s.start)}–{pad(s.end)}</span> {s.name}
            </span>
          ))
        }
      </div>
    </section>

    <SiteFooter />
  </div>

  <ContactDialog />

  <script>
    import '../scripts/hero.ts';
    import '../scripts/request.ts';
    import '../scripts/contact.ts';
  </script>
</Base>
