---
/**
 * THE BOLT — home ("02 Shear v2", Nov 2026). Priority order: On air → Just played → Request.
 *
 * The song areas ship as SUSPENSE — skeleton washes, never placeholder tracks; a production
 * page must not assert songs it isn't playing. scripts/onair.ts subscribes to THE BOLT's
 * now-playing feed (one poll, shared with the dock) and resolves each area on the first
 * snapshot: the live track, the just-played list, or the honest empty state.
 *
 * Reserved slots (station.features): the daypart label on the ON AIR row and the SPINDEX
 * track-file panel. Both off at launch.
 *
 * Future (with live SPINDEX + tally infra): a listener-split bar under the SongRank buttons and
 * room-average squares on Just Played rows. Today the squares show THIS listener's own rating;
 * no endpoint exposes vote tallies.
 */
import Base from '../layouts/Base.astro';
import SiteMast from '../components/SiteMast.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { station } from '../config/station';

const rank = ['Hate', 'Dislike', 'Neutral', 'Like', 'Love'];
const { daypart, spindex } = station.features;
---

<Base
  title={`${station.name} — Vegas's Live Rock Radio | A ClubFM Station`}
  description={`Listen live to ${station.name}, Vegas's rock station — modern rock, '90s–2015 new classics, and '60s–'70s classic rock, streaming around the clock at ${station.domain}.`}
>
  <div class="site">
    <SiteMast home />

    <main id="top">
      <!-- ON AIR -->
      <section class="hero wrap" aria-labelledby="np-title" data-onair>
        <div class="hero__bar">
          <span class="tag"><span>On air</span></span>
          <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="hero__rule" aria-hidden="true"></span>
          {daypart && <span class="slot-chip" data-daypart>Daypart · reserved</span>}
        </div>

        <div class="hero__main">
          <div class="hero__meta">
            <h1 id="np-title" class="np-title t-display" data-np-title>
              <span class="skel skel--title"></span>
            </h1>
            <p class="np-artist t-label red-text" data-np-artist>
              <span class="skel skel--artist"></span>
            </p>
            <p class="np-rel t-mono muted" data-np-release></p>
          </div>
          <div class="hero__art">
            {/* Parallelogram sleeve. No src until the feed delivers real art; without art the
                hatched field stands in (decorative, no fake label). */}
            <div class="sleeve" data-sleeve data-has-art="false">
              <img alt="" data-np-art decoding="async" />
            </div>
          </div>
        </div>

        <div class="rank" role="group" aria-labelledby="sr-label" data-rank>
          <div class="rank__head">
            <span class="rank__h">
              <span id="sr-label" class="rank__title t-display">SongRank</span>
              <span class="rank__cue t-label red-text">Rate it — tap a slant ↓</span>
            </span>
            <span class="rank__note t-mono muted" data-rank-note>Tap to rate</span>
          </div>
          <div class="rank__opts">
            {
              rank.map((label, i) => (
                <button class="rank__btn" type="button" aria-pressed="false" value={String(i + 1)}>
                  <span>{label}</span>
                </button>
              ))
            }
          </div>
          <p class="sr" role="status" aria-live="polite" id="rank-status"></p>
        </div>

        {
          spindex && (
            <div class="spindex" data-spindex>
              <span class="spindex__txt">
                <span class="spindex__h t-mono">SPINDEX</span>
                <span class="spindex__d muted">
                  Track file — liner notes, chart history, listener takes
                </span>
              </span>
              <span class="spindex__tag t-mono muted">Reserved</span>
            </div>
          )
        }
      </section>

      <!-- JUST PLAYED + REQUEST -->
      <div class="band">
        <div class="band__in wrap">
          <section id="played" class="played" aria-labelledby="jp-h">
            <h2 id="jp-h" class="band__h t-display">Just played</h2>
            <ol class="rows" data-history>
              {/* Suspense rows — replaced by real history (or an honest empty state) on the
                  first snapshot. Never placeholder songs. */}
              {
                Array.from({ length: 5 }).map(() => (
                  <li class="row">
                    <span class="row__t">
                      <span class="skel skel--t" />
                    </span>
                    <span class="row__trk">
                      <span class="skel skel--trk" />
                    </span>
                    <span />
                  </li>
                ))
              }
            </ol>
            <a class="slant" href="/log"><span>Full log →</span></a>
          </section>

          <section id="request" class="req" aria-labelledby="rq-h">
            <h2 id="rq-h" class="band__h t-display">Request</h2>
            <p class="req__copy muted">Name the track. The studio sees it right away.</p>
            <form class="req__form" method="post" action="/api/request" data-request-form>
              <label class="req__label t-label" for="req">Song &amp; artist</label>
              <input
                id="req"
                class="req__input"
                name="song"
                type="text"
                placeholder="Song — Artist"
                required
                maxlength="120"
                autocomplete="off"
              />
              {/* Honeypot — hidden from people, tempting to bots. A filled value is dropped server-side. */}
              <input class="sr" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button class="slant slant--red req__send" type="submit"><span>Send it</span></button>
              <p class="status sr" role="status" aria-live="polite" data-request-status></p>
            </form>
          </section>
        </div>
      </div>
    </main>

    <SiteFooter />
  </div>

  <ContactDialog />

  <script>
    import '../scripts/onair.ts';
    import '../scripts/request.ts';
    import '../scripts/contact.ts';
  </script>
</Base>
