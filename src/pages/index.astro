---
/**
 * THE BOLT — home.
 *
 * The values below are the server-rendered FIRST PAINT only — believable defaults so the page
 * reads correctly before JS and for crawlers. At runtime scripts/hero.ts subscribes to the
 * shared now-playing store (one poll for the whole page, owned by the dock) and replaces the
 * track, elapsed bar, listener count, and just-played list live; scripts/ui.ts owns theme +
 * art-toggle. Listener features (request, SongRank POST) and the full log are separate phases.
 */
import Base from '../layouts/Base.astro';
import BoltLockup from '../components/BoltLockup.astro';
import { station } from '../config/station';

// Server-rendered first paint. Overwritten live by scripts/hero.ts once the store emits.
const np = {
  title: 'Starburster',
  artist: 'Fontaines D.C.',
  release: 'Romance · 2024',
  duration: '3:22',
  clock: '20:07',
  elapsedPct: 61,
  art: '/sample-art.svg',
};

const history = [
  { time: '20:03', title: 'Gift Horse', artist: 'Idles', rating: 4 },
  { time: '19:59', title: 'No One Knows', artist: 'Queens of the Stone Age', rating: 5 },
  { time: '19:55', title: 'HOLIDAY', artist: 'Turnstile', rating: 3 },
  { time: '19:51', title: 'I Got Heaven', artist: 'Mannequin Pussy', rating: 4 },
  { time: '19:47', title: 'My Own Summer', artist: 'Deftones', rating: 5 },
];

const pad = (n: number) => String(n).padStart(2, '0');
// Stage 1: current show hardcoded (server-side, tz-aware marking comes in a later stage).
const currentShow = 'The Active Hours';

const rank = ['Hate', 'Dislike', 'Neutral', 'Like', 'Love'];
---

<Base>
  <div class="site">
    <header class="mast">
      <a class="wm" href="/" aria-label={`${station.name} — home`}>
        <BoltLockup />
      </a>
      <nav aria-label="Sections">
        <a href="#air">On air</a><a href="#played">Just played</a><a href="#request">Request</a><a
          href="#shows">Shows</a
        >
      </nav>
      <div class="util">
        <span class="sig">A ClubFM station</span>
        <button class="tgl" type="button" id="theme">Light</button>
        <button class="tgl" type="button" id="art">Art off</button>
      </div>
    </header>

    <!-- ON AIR -->
    <section class="band hero" id="air" aria-labelledby="air-h">
      <div class="gut">
        <h2 id="air-h">On air</h2>
        <figure class="plate" style="margin:0">
          <img src={np.art} alt="" data-np-art decoding="async" />
          <span class="tint" aria-hidden="true"></span>
          <span class="scr" aria-hidden="true"></span>
        </figure>
        <p class="sub">On air · <span data-np-clock>{np.clock}</span></p>
      </div>
      <div>
        <h3 class="track" data-np-title>{np.title}</h3>
        <p class="artist" data-np-artist>{np.artist}</p>
        <p class="rel">
          <span data-np-release>{np.release}</span> · <span data-np-duration>{np.duration}</span>
        </p>
        <div class="el"><i data-np-elapsed style={`width:${np.elapsedPct}%`}></i></div>

        <div class="rank" data-rank role="group" aria-label="Rate this song">
          <span class="rank-h" aria-hidden="true">Rate this song</span>
          {
            rank.map((label, i) => (
              <button type="button" aria-pressed="false" value={String(i + 1)}>
                {label}
              </button>
            ))
          }
        </div>
        <p class="sr" role="status" aria-live="polite" id="rank-status"></p>
      </div>
    </section>

    <!-- REQUEST -->
    <section class="band req" id="request" aria-labelledby="req-h">
      <h2 id="req-h">Request</h2>
      <form method="post" action="/api/request" data-request-form>
        <label class="sr" for="req">Request a song</label>
        <input
          id="req"
          name="song"
          type="text"
          placeholder="Artist — title"
          required
          maxlength="120"
          autocomplete="off"
        />
        {/* Honeypot — hidden from people, tempting to bots. A filled value is dropped server-side. */}
        <input class="sr" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button type="submit">Send it</button>
        <p class="req-status sr" role="status" aria-live="polite" data-request-status></p>
      </form>
    </section>

    <!-- JUST PLAYED -->
    <section class="band" id="played" aria-labelledby="played-h">
      <h2 id="played-h">Just played</h2>
      <div>
        <table data-history>
          <caption class="sr">The last five songs, with ratings</caption>
          <colgroup>
            <col style="width:56px" /><col /><col style="width:80px" />
          </colgroup>
          <tbody>
            {
              history.map((h) => (
                <tr>
                  <td class="tm">{h.time}</td>
                  <td class="nm">
                    <b>{h.title}</b> <s>— {h.artist}</s>
                  </td>
                  <td class="tk">
                    {[1, 2, 3, 4, 5].map((n) => (
                      <i class={n <= h.rating ? 'on' : ''} />
                    ))}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <a class="more" href="/log">Full log →</a>
      </div>
    </section>

    <!-- SHOWS -->
    <section class="band" id="shows" aria-labelledby="shows-h">
      <h2 id="shows-h">Shows</h2>
      <div class="shows">
        {
          station.shows.map((s) => (
            <span {...(s.name === currentShow ? { 'aria-current': 'true' } : {})}>
              {pad(s.start)}–{pad(s.end)} {s.name}
            </span>
          ))
        }
      </div>
    </section>

    <footer>
      <span><span data-listeners>1,240</span> listening</span>
      <span>Stereo · 64k</span>
    </footer>
  </div>

  <script>
    import '../scripts/hero.ts';
    import '../scripts/request.ts';
  </script>
</Base>
