---
/**
 * THE BOLT — masthead. Inline lockup, then the nav: Played, Request, a skewed outlined
 * Contact button (opens the contact dialog), and the theme toggle.
 *
 *   home — nav anchors are same-page (#played); elsewhere they point back at /#played.
 */
import BoltLockup from './BoltLockup.astro';
import ThemeToggle from './ThemeToggle.astro';
import { station } from '../config/station';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const base = home ? '' : '/';
---

<header class="mast wrap">
  <a class="mast__home" href="/" aria-label={`${station.name}, home`}>
    <BoltLockup />
  </a>
  <nav class="mast__nav t-label" aria-label="Primary">
    <a href={`${base}#played`}>Played</a>
    <a href={`${base}#request`}>Request</a>
    <button class="slant slant--sm" type="button" data-contact-open><span>Contact</span></button>
    <ThemeToggle />
  </nav>
</header>
