---
/**
 * THE BOLT — on-site lockup (bolt + wordmark), inlined so it inks with currentColor and flips
 * with the theme. Source: docs/redesign-2026-11/brand/svg/the-bolt_horizontal_currentColor.svg
 * (outlined — no font dependency). The bolt leans 8°, the wordmark stays upright; flat, one
 * ink, no gradient/glow/outline/shadow.
 *
 * The source file carries generous artboard padding; the viewBox is cropped to the ink so the
 * mark sits flush in the masthead. Sized by height in CSS (.lockup); width follows.
 */
import raw from '../assets/brand/the-bolt_horizontal_currentColor.svg?raw';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const paths = raw
  .replace(/^[\s\S]*?<\/title>/, '')
  .replace(/<\/svg>\s*$/, '');
---

<svg
  class:list={['lockup', className]}
  viewBox="26 21 654 111"
  role="img"
  aria-label="The BOLT"
  preserveAspectRatio="xMinYMid meet"
  set:html={paths}
/>
