---
/**
 * THE BOLT — footer. Copyright, Chart, Listen, Contact, Privacy (opens the dialog), SwagShop, stream spec.
 * SwagShop is a separate Shopify site; it opens in a new tab so the dock keeps playing here.
 */
import { station } from '../config/station';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__in wrap">
    <span>© {year} Radiant Ventures · A CLUBFM station</span>
    <span class="foot__links">
      <a href="/chart">Chart</a>
      <a href="/listen">Listen</a>
      <button type="button" data-contact-open>Contact</button>
      <a href={station.swagShop.url} target="_blank" rel="noopener">{station.swagShop.short}</a>
      <a href="/privacy">Privacy</a>
      <span>Stereo · 64k</span>
    </span>
  </div>
</footer>
