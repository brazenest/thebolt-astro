---
/**
 * THE BOLT — footer. Copyright, Chart, Listen, About, Contact, Privacy (opens the dialog), SwagShop, stream spec.
 * SwagShop is a separate Shopify site; it opens in a new tab so the dock keeps playing here.
 */
import { station } from '../config/station';
const year = new Date().getFullYear();
// Stream spec per feed ("Stereo · 64k" / "Stereo · 192k Plus"); ui.ts shows the one the dock
// is set to. SSR shows the default feed.
const spec = (f: { id: string; label: string; detail?: string }) =>
  `Stereo · ${(f.detail ?? '').split(' ')[0]}${f.id === station.stream.defaultFeed ? '' : ` ${f.label}`}`;
const feedSpecs = Object.fromEntries(
  station.stream.feeds.filter((f) => f.stream).map((f) => [f.id, spec(f)]),
);
---

<footer class="foot">
  <div class="foot__in wrap">
    <span>© {year} Radiant Ventures · A CLUBFM station</span>
    <span class="foot__links">
      <a href="/chart">Chart</a>
      <a href="/listen">Listen</a>
      <a href="/about">About</a>
      <button type="button" data-contact-open>Contact</button>
      <a href={station.swagShop.url} target="_blank" rel="noopener">{station.swagShop.short}</a>
      <a href="/privacy">Privacy</a>
      <span data-feed-spec={JSON.stringify(feedSpecs)}
        >{feedSpecs[station.stream.defaultFeed] ?? 'Stereo · 64k'}</span
      >
    </span>
  </div>
</footer>
