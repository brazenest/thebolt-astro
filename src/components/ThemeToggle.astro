---
/**
 * Theme toggle — a square, 44px, icon-only control. The icon is a square split on the bolt's
 * lean: the filled half is the current theme's ink. scripts/ui.ts owns behaviour and keeps the
 * accessible label in sync ("Switch to light theme" / "Switch to dark theme").
 */
---

<button class="theme-tgl" type="button" id="theme" aria-label="Switch theme">
  <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
    <rect x="2" y="2" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"
    ></rect>
    <path d="M12 2 H18 V18 H8 Z" fill="currentColor"></path>
  </svg>
</button>
