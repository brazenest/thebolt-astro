{
  // THE BOLT — Cloudflare Worker config (Astro CF adapter output).
  //
  // Local `astro dev` reads these bindings through the adapter's platformProxy (miniflare), so
  // D1 + KV work offline once you've applied migrations locally (see package.json db:* scripts).
  // The IDs below are placeholders — create the real resources and paste their IDs before a
  // production deploy (see DEPLOY notes at the bottom).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thebolt-astro",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // Adapter build output: the worker entry (our workerEntryPoint) + the static assets.
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },

  // Cron → worker.ts scheduled():
  //   "* * * * *" — capture the on-air track into the plays log (60s).
  //   "0 * * * *" — additionally send the hourly SongRank digest.
  "triggers": {
    "crons": ["* * * * *", "0 * * * *"]
  },

  // SongRank ledger + plays log.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thebolt",
      "database_id": "6a3f8eb5-3098-4aa9-b91e-14bb932945df",
      "migrations_dir": "migrations"
    }
  ],

  // Fixed-window rate limiter for /api/request and /api/rank. Unbound → fails open.
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "39a87bc6d18c4cc59a2ac91eb4877da6"
    }
  ]

  // Secrets (set with `wrangler secret put <NAME>`, or .dev.vars locally):
  //   RESEND_API_KEY, EMAIL_FROM, EMAIL_TO   — Resend delivery (requests + digest)
  //   TURNSTILE_SECRET_KEY                   — request-form verification
  //   RANK_SECRET                            — SongRank nonce HMAC (sign in proxy, verify in /api/rank)
  //   AZURACAST_BASE_URL, AZURACAST_BOLT_SHORTCODE — now-playing source
  // Public build var (in .env): PUBLIC_TURNSTILE_SITE_KEY, PUBLIC_STREAM_URL, PUBLIC_STREAM_FALLBACK_URL
}
